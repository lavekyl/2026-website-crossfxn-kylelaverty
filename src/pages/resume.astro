---
// The résumé lives in src/data/resume.md so it can be edited anywhere,
// including GitHub's web editor. This page only styles it and tidies the markup:
//   - "|" separators in headings and lines are hidden from screen readers
//   - links to other sites open in a new tab and say so to screen readers
import Base from "../layouts/Base.astro";
import * as resume from "../data/resume.md";
import "../styles/print.css";

const PDF = "/pdf/KyleLaverty_Resume_2026.pdf";

let html = await resume.compiledContent();
html = html
  // Hide the visual pipe separators from assistive tech.
  .replace(/ \| /g, ' <span class="sep" aria-hidden="true">|</span> ')
  // External links: new tab, announced.
  .replace(/<a href="(https?:\/\/[^"]+)">(.*?)<\/a>/g, (_m, href, text) =>
    `<a href="${href}" target="_blank" rel="noopener">${text}<span class="visually-hidden"> (opens in a new tab)</span></a>`,
  );
---
<Base
  title="Résumé | Kyle Laverty, Senior Web Developer"
  description="Résumé for Kyle Laverty: senior web developer and U.S. Air Force veteran. Experience at Fingerpaint Medical, Highspot and Walk West, plus independent work under Crossfxn LLC."
  path="/resume"
>
  <div class="content-wrapper">
    <div class="content-well resume-page">
      <div class="resume-tools">
        <a class="btn" href={PDF} download>Download PDF</a>
        <button class="btn btn--ghost" type="button" data-print hidden>Print</button>
      </div>
      <article class="resume" aria-labelledby="kyle-laverty" set:html={html} />
    </div>
  </div>
</Base>

<style is:global>
  .resume-page{--wrapper-padding:3rem}
  .resume-tools{display:flex;flex-wrap:wrap;gap:.75rem;justify-content:flex-end;margin-bottom:1.5rem}
  .resume{background:var(--paper);color:#1b1a17;border-radius:6px;padding:clamp(1.5rem,5vw,3.5rem);box-shadow:0 30px 80px -30px rgba(0,0,0,.7);font-size:1rem;line-height:1.5}
  .resume a{color:#1b1a17;text-decoration:underline;text-decoration-color:#b5541a;text-decoration-thickness:1.5px;text-underline-offset:.2em}
  .resume a:hover{color:#8a3a0c;text-decoration-thickness:2.5px}
  .resume a:focus-visible{outline:3px solid #b5541a;outline-offset:2px}
  .resume .sep{color:#6b675e;margin:0 .1rem}

  /* name, headline, contact row */
  .resume > h1{font-size:clamp(2rem,5vw,2.8rem);font-weight:800;letter-spacing:-.03em}
  .resume > h1 + p{margin:.25rem 0 0;font-weight:600;color:#4a4740}
  .resume > h1 + p + ul{display:flex;flex-wrap:wrap;gap:.25rem 1rem;list-style:none;margin:.75rem 0 0;padding:0;font-size:.92rem;color:#4a4740}

  /* sections */
  .resume h2{font-family:var(--font-body);font-size:1.05rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-top:2rem;padding-bottom:.35rem;border-bottom:2px solid #1b1a17}
  .resume h2 + p{margin-top:.75rem}
  .resume h3{font-family:var(--font-body);font-size:1.02rem;font-weight:600;letter-spacing:0;line-height:1.35;margin-top:1.1rem}
  .resume h3 + p{margin:.1rem 0 0;font-size:.9rem;color:#4a4740}
  .resume h3 ~ ul{margin:.45rem 0 0;padding-left:1.2rem}
  .resume h3 ~ ul li + li{margin-top:.3rem}
  .resume h2 ~ p:has(> strong:first-child){margin-top:.5rem}
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-print]");
  if (btn) {
    btn.hidden = false;
    btn.addEventListener("click", () => window.print());
  }
</script>
