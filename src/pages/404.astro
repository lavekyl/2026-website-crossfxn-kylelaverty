---
import Base from "../layouts/Base.astro";
---
<Base title="Lost in space | Kyle Laverty" description="This page doesn't exist." path="/404" noindex>
  <section class="section">
    <div class="content-wrapper">
      <div class="content-well-wide">
        <p class="eyebrow">Error 404</p>
        <h1 class="display" style="font-size:clamp(2.6rem,7vw,5rem);font-weight:800;margin-top:1rem">Lost in space.</h1>
        <p style="margin-top:1.25rem;color:var(--paper-soft);font-size:1.2rem;max-width:40ch">That page drifted off. The rest of the site is right where you left it.</p>
        <div class="actions" style="margin-top:2rem"><a class="btn" href="/">Back to home</a><a class="btn btn--ghost" href="/#work">See my work</a></div>
      </div>
    </div>
  </section>
</Base>
