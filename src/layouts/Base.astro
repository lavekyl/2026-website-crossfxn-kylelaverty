---
import "../styles/smidgen.min.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/site.css";
import Starfield from "../components/Starfield.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  ogImageAlt?: string;
}
const {
  title,
  description,
  path = "/",
  noindex = false,
  ogImageAlt = "Kyle Laverty, Senior Web Developer. A hand-drawn rocket lifting off a starfield.",
} = Astro.props;
const canonical = new URL(path, Astro.site).href;
// Bump ?v= whenever og-image.png changes, so social platforms fetch the new one.
const ogImage = new URL("/og-image.png?v=3", Astro.site).href;
const GA_ID = "G-BHJXKZHLZX";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://kylelaverty.com/#kyle",
      name: "Kyle Laverty",
      url: "https://kylelaverty.com",
      image: ogImage,
      jobTitle: "Senior Web Developer",
      description:
        "Senior web developer and U.S. Air Force veteran building fast, accessible, maintainable websites and applications.",
      worksFor: { "@type": "Organization", name: "Fingerpaint Medical" },
      founder: { "@id": "https://crossfxn.com/#org" },
      alumniOf: { "@type": "CollegeOrUniversity", name: "Pennsylvania State University" },
      address: { "@type": "PostalAddress", addressLocality: "Apex", addressRegion: "NC", addressCountry: "US" },
      sameAs: ["https://github.com/lavekyl", "https://linkedin.com/in/lavekyl"],
      knowsAbout: ["Web development", "Accessibility", "Section 508", "WordPress", "Astro", "SvelteKit", "TypeScript", "Web performance"],
    },
    {
      "@type": "WebSite",
      "@id": "https://kylelaverty.com/#site",
      url: "https://kylelaverty.com",
      name: "Kyle Laverty",
      publisher: { "@id": "https://kylelaverty.com/#kyle" },
    },
    // The home page is Kyle's profile page; Google uses this for name and image.
    ...(path === "/"
      ? [{ "@type": "ProfilePage", "@id": "https://kylelaverty.com/#profile", url: canonical, mainEntity: { "@id": "https://kylelaverty.com/#kyle" } }]
      : []),
    {
      "@type": "Organization",
      "@id": "https://crossfxn.com/#org",
      name: "Crossfxn LLC",
      url: "https://crossfxn.com",
      description: "Media and technology company that builds and runs independent brands across publishing, commerce, developer tools and civic data.",
      founder: { "@id": "https://kylelaverty.com/#kyle" },
      address: { "@type": "PostalAddress", addressLocality: "Apex", addressRegion: "NC", addressCountry: "US" },
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Decide on motion before first paint, so nothing flashes or half-animates. -->
    <script is:inline>
      (function () {
        var off = false;
        try { off = localStorage.getItem("kl-motion") === "off"; } catch (e) {}
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) off = true;
        document.documentElement.dataset.motion = off ? "off" : "on";
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0f1e" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hanken-grotesk-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kyle Laverty" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google Analytics, loaded after the page is idle so it never blocks rendering. -->
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", GA_ID);
      window.addEventListener("load", function () {
        var go = function () {
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
          document.head.appendChild(s);
        };
        "requestIdleCallback" in window ? requestIdleCallback(go, { timeout: 3000 }) : setTimeout(go, 1500);
      });
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <!-- Shared ink filter for every hand-drawn SVG on the page. -->
    <svg width="0" height="0" class="ink-defs" aria-hidden="true" focusable="false">
      <filter id="ink" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="4" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="3" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <Starfield />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
